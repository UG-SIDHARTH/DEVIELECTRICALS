# ==============================================================================
# Devi Electrical - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in this directory (project root):
#   cp .env.example .env
#
# NOTE: Highly sensitive keys (database passwords, encryption keys, pepper)
# are stored as separate files in the ./secrets/ directory for Docker secrets
# protection. Only high-level configuration is placed here.
# ==============================================================================

# Public HTTPS origin where the site and billing app are accessed.
# CRITICAL: Must start with https:// (or http:// for local testing) and have NO trailing slash.
PUBLIC_ORIGIN=https://<YOUR_PUBLIC_ORIGIN>

# Network Ports
# Port 3164 -> Public Marketing Website
# Port 3165 -> Private Staff Billing & Inventory App
MARKETING_PORT=3164
BILLING_PORT=3165

# Environment: production, development, or test
NODE_ENV=production

# Server timezone (Kerala / Indian Standard Time)
TZ=Asia/Kolkata

# Optional AI scan vision model configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
