{
  "name": "devi-electrical",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production management, billing, inventory, and public website for Devi Electrical, Kazhakkoottam",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/assets/app.css --minify",
    "build:assets": "node scripts/build-assets.js",
    "build": "npm run build:css && npm run build:assets",
    "init-secrets": "node scripts/init-secrets.js",
    "create-owner": "node scripts/create-owner.js",
    "start": "node --max-old-space-size=384 server/index.js",
    "migrate": "node server/db/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jimp": "^1.6.0",
    "otplib": "^12.0.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.1",
    "@fontsource/plus-jakarta-sans": "^5.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "autoprefixer": "^10.4.20",
    "lucide-static": "^0.473.0",
    "postcss": "^8.4.49",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tesseract.js": "^5.1.1",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
